# =============================================================================
# 环境变量示例文件
#
# 使用方法：把本文件复制为同目录下的 .env，按实际情况修改。
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# 说明：所有配置项都有代码内置的默认值（见 config.py），
#       本文件中的值只需保留你确实想覆盖的项即可，未配置的项将使用默认值。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、Flask 基础配置
# -----------------------------------------------------------------------------
# JWT 签名密钥，生产环境务必改成随机长字符串
SECRET_KEY=enterprise-qa-secret-key-2024
# 调试模式：True=改代码自动重启（开发用），生产环境请设为 False
DEBUG=True

# -----------------------------------------------------------------------------
# 二、MySQL 数据库（注意端口为 3308）
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=db_enterprise_qa

# -----------------------------------------------------------------------------
# 三、登录令牌有效期（单位：秒，默认 7 天）
# -----------------------------------------------------------------------------
JWT_EXPIRE_SECONDS=604800

# -----------------------------------------------------------------------------
# 四、Ollama 大模型与嵌入模型
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 对话大模型
LLM_MODEL=qwen3:8b
# 向量化嵌入模型
EMBEDDING_MODEL=qwen3-embedding:4b
# 模型温度：越低回答越稳定，知识库问答建议 0 ~ 0.3
LLM_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# 五、RAG 检索与切分参数（调整这些值可以改变问答效果）
# -----------------------------------------------------------------------------
# 每次检索返回的文本块数量
RETRIEVE_TOP_K=4
# 余弦距离阈值（distance = 1 - 余弦相似度），大于该值的片段会被丢弃
#   调小（如 0.6）→ 只保留高度相关片段，回答更严谨但可能漏召回
#   调大（如 1.2）→ 召回更多片段，但可能引入无关内容
RETRIEVE_SCORE_THRESHOLD=1.0
# 每个文本块的最大字符数
CHUNK_SIZE=500
# 相邻文本块的重叠字符数，用于保持语义连贯
CHUNK_OVERLAP=80

# -----------------------------------------------------------------------------
# 六、向量库目录（一般无需修改，默认 server/chroma_db）
# -----------------------------------------------------------------------------
# CHROMA_DIR=D:/Code/VSCode/LangChain_RAG/server/chroma_db
